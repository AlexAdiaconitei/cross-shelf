{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"attribution": {
		"commit": "",
		"pr": ""
	},
	"includeCoAuthoredBy": false,
	"permissions": {
		"deny": [
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(**/.env)",
			"Read(**/.env.local)",
			"Read(**/.env.production)",
			"Read(**/secrets/**)",
			"Read(**/*.pem)",
			"Read(**/*.key)",
			"Read(**/client_secret_*.json)",
			"Read(**/*keypair*.json)",
			"Read(**/*.enc)",
			"Bash(git push:*)",
			"Bash(gh release create:*)",
			"Bash(npm install:*)",
			"Bash(npx:*)",
			"Bash(pnpm publish:*)",
			"Bash(npm publish:*)",
			"Bash(cargo publish:*)"
		],
		"allow": [
			"Read(./.env.example)",
			"Bash(pnpm check:*)",
			"Bash(pnpm test:*)",
			"Bash(pnpm lint:*)",
			"Bash(pnpm format:*)",
			"Bash(pnpm build:*)",
			"Bash(cargo fmt:*)",
			"Bash(cargo check:*)",
			"Bash(cargo clippy:*)",
			"Bash(cargo test:*)",
			"Bash(cargo build:*)"
		]
	}
}
