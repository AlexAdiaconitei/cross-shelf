# LF everywhere in the repository; Windows checkouts keep LF too, so Prettier and the CI see the
# same bytes as the editor.
* text=auto eol=lf

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.gif binary
*.woff2 binary
*.zip binary

pnpm-lock.yaml linguist-generated=true -diff
Cargo.lock linguist-generated=true -diff
uv.lock linguist-generated=true -diff
drizzle/meta/** linguist-generated=true
