{
	"name": "cross-shelf",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run --passWithNoTests",
		"tauri": "tauri"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24 <25"
	},
	"dependencies": {
		"@ark-ui/svelte": "5.25.1",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@tabler/icons-svelte": "3.51.0",
		"@tauri-apps/api": "2.12.4",
		"@tauri-apps/plugin-dialog": "~2.8.4",
		"@tauri-apps/plugin-log": "~2.10.2",
		"@tauri-apps/plugin-opener": "2.7.3",
		"@tauri-apps/plugin-process": "~2.4.0",
		"@tauri-apps/plugin-updater": "~2.14.1",
		"@tauri-apps/plugin-window-state": "~2.5.0",
		"clsx": "2.1.1",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@tauri-apps/cli": "2.12.4",
		"@types/node": "24.19.2",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.7",
		"vitest": "5.1.0"
	}
}
