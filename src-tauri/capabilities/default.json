{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "What the main window may do. Grant per plugin and per command, never core:default plus everything.",
	"windows": ["main"],
	"permissions": [
		"core:default",
		{
			"identifier": "opener:allow-open-url",
			"allow": [
				{ "url": "https://store.steampowered.com/*" },
				{ "url": "https://www.gog.com/*" },
				{ "url": "https://store.epicgames.com/*" }
			]
		},
		"process:allow-restart",
		"updater:default",
		"dialog:allow-open",
		"dialog:allow-save",
		"window-state:default",
		"log:default"
	]
}
